<!DOCTYPE html>
<html lang="{{ with .lang }}{{ . }}{{ else }}en{{ end }}" class="no-js">
{{ template "head" . }}
<body>
<a class="skip-link" href="#main">Skip to content</a>

{{ template "site-header" . }}

<main id="main" class="wrapper flow" tabindex="-1">
	<h1>{{ with .heading }}{{ . }}{{ else }}{{ .title }}{{ end }}</h1>

	{{- with .intro }}
	<p class="lead">{{ . }}</p>
	{{- end }}

	{{- /* Rich text from the CMS. Typed template.HTML in Go, so it is not escaped. */}}
	{{- with .body }}
	<div class="flow">{{ . }}</div>
	{{- end }}

	{{- with .articles }}
	<h2>Latest</h2>
	<ul class="post-list flow">
		{{- range . }}
		<li>
			<article class="post flow">
				<header class="flow">
					<h3><a href="{{ .URL }}">{{ .Title }}</a></h3>
					<p class="post__meta">
						{{- with .PublishedAt }}
						<time datetime="{{ .Format "2006-01-02" }}">{{ .Format "2 January 2006" }}</time>
						{{- end }}
						{{- with .Author }} &middot; {{ . }}{{ end }}
					</p>
				</header>
				{{- with .Summary }}
				<p>{{ . }}</p>
				{{- end }}
				<p><a href="{{ .URL }}">Continue reading&hellip;</a></p>
			</article>
		</li>
		{{- end }}
	</ul>
	{{- end }}
</main>

{{ template "site-footer" . }}
</body>
</html>
